# ==============================================================================
# ServiceFlow - Global Docker Environment Variables Template
# ==============================================================================
# Copy this file to .env if you need to override default Docker Compose settings.

# Express Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Inside Docker Network)
MONGO_URI=mongodb://mongodb:27017/serviceflow

# JWT Security
JWT_SECRET=serviceflow_docker_production_secret_key_99
JWT_EXPIRES_IN=7d

# Cross-Origin URL (Frontend Origin)
CLIENT_URL=http://localhost:5173

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
